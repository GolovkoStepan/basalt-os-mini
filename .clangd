# Конфиг clangd для проекта: ESP32-S3 / Xtensa, платформа espressif32@8.0.0.
#
# Файл лежит в репозитории проекта: у basalt-os (отдельный репозиторий) другой
# тулчейн — riscv32, и его include-пути несовместимы с этими. clangd объединяет
# конфиги из всех родительских каталогов, поэтому общий файл в корне лабы
# добавлял бы чужие -isystem в каждый проект.
#
# Что чинится здесь (замерено `clangd --check` на pulsar/src/main.cpp — тот же
# тулчейн и та же платформа, что здесь):
#   без файла ...................... 4 ошибки
#       три флага GCC, которых clang не знает, плюс 'stdbool.h' file not found
#   с файлом ....................... 0 ошибок
#
# Отсюда две части и обе нужны:
#   Remove — убрать флаги GCC, которые приходят из platformio.ini;
#   Add    — дать picolibc и libstdc++ тулчейна: сам clangd их не находит.
#            Именно picolibc: с GCC 15 прошивка собирается с picolibc.specs, а
#            newlib в тулчейне лежит рядом и разбирается с ошибками.
#
# Одного --query-driver из ~/.config/zed/settings.json недостаточно: с ним, но
# без этого файла, ошибок становится 8 — GCC-ные заголовки конфликтуют с
# заголовками clang и ломают перегрузки (println, printf).
#
# ВНИМАНИЕ: пути содержат версию GCC (15.2.0). После обновления espressif32
# или тулчейна их нужно поправить. Проверить актуальную версию:
#   ls ~/.platformio/packages/toolchain-xtensa-esp-elf/lib/gcc/xtensa-esp-elf/
# Если clangd перестал видеть стандартные заголовки (<string>, <cstdint>) —
# почти всегда причина именно в этом.
#
# После изменения platformio.ini (флаги, библиотеки) обновите базу проекта:
#   pio run -t compiledb

CompileFlags:
  Remove:
    - -mdisable-hardware-atomics
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion
    # Флаги GCC 15, которых clang не знает. Появились вместе с обновлением
    # тулчейна; без Remove clangd ругается на каждую строку базы.
    - -fzero-init-padding-bits=all
    - -fno-malloc-dce
    - -fno-shrink-wrap
  # ВАЖНО: флаг и путь - два отдельных элемента списка. Одной строкой
  # "-isystem /путь" clangd 21 передаёт их одним аргументом, драйвер видит
  # значение с ведущим пробелом, каталога не находит - и clangd перестаёт
  # видеть stdbool.h и всё остальное стандартное.
  #
  # ВАЖНО: libc - это picolibc, а не newlib. Начиная с GCC 15 прошивка
  # собирается с -specs=picolibc.specs, и заголовки приходят из
  # toolchain/picolibc/include. Старый набор в toolchain/xtensa-esp-elf/include
  # лежит рядом и находится тоже - но это ЧУЖОЙ набор: clangd на нём падает с
  # "_mbstate_t unknown" и "__FILE unknown". Путь обязан вести в picolibc.
  Add:
    - -isystem
    - /Users/s.golovko/.platformio/packages/toolchain-xtensa-esp-elf/picolibc/include
    - -isystem
    - /Users/s.golovko/.platformio/packages/toolchain-xtensa-esp-elf/lib/gcc/xtensa-esp-elf/15.2.0/include
    - -isystem
    - /Users/s.golovko/.platformio/packages/toolchain-xtensa-esp-elf/picolibc/xtensa-esp-elf/include/c++/15.2.0
    - -isystem
    - /Users/s.golovko/.platformio/packages/toolchain-xtensa-esp-elf/picolibc/xtensa-esp-elf/include/c++/15.2.0/xtensa-esp-elf/esp32
    - -isystem
    - /Users/s.golovko/.platformio/packages/toolchain-xtensa-esp-elf/picolibc/xtensa-esp-elf/include/c++/15.2.0/backward
